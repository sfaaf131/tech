# Copiar este archivo a .env y completar con valores reales.
# Nunca commitear el archivo .env (ya está en .gitignore).

# Base de datos Postgres (recomendado: Neon, gratis, se integra con Vercel)
DATABASE_URL="postgresql://usuario:password@host/dbname?sslmode=require"

# NextAuth: clave secreta para firmar sesiones. Generar con: openssl rand -base64 32
AUTH_SECRET=""

# URL pública base de la app. En local: http://localhost:3000
# Se usa para construir las URLs de retorno de Stripe (checkout y onboarding de Connect).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (modo test mientras se desarrolla)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Client ID de la app de Stripe Connect (para que los productores conecten su cuenta)
STRIPE_CONNECT_CLIENT_ID="ca_..."

# Almacenamiento de archivos de audio (preview, pista completa, stems).
# En local se guardan en public/uploads (servidos por Next.js en /uploads/...).
# TODO: migrar a Vercel Blob (o S3) antes de desplegar a producción.
# En Vercel no se puede escribir al filesystem local de forma persistente.
